# Verplicht voor Telegram alerts
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789   # of @kanaalnaam voor een publiek kanaal

# Optioneel: storingsmeldingen apart, bv. als TELEGRAM_CHAT_ID een publiek kanaal is
TELEGRAM_ADMIN_CHAT_ID=

# Optioneel
GITHUB_TOKEN=                  # verhoogt GitHub rate limit (in Actions automatisch)
WATCH_KINDS=mainnet,testnet,devnet,upcoming,proposal
NOTIFY_CROSS_LISTING=false     # alert als bekende chain op nieuwe bron verschijnt
DISABLED_SOURCES=              # bv: coingecko,defillama
MAX_ALERTS_PER_RUN=25

# Verrijking: socials, domeinleeftijd (RDAP) en GitHub-org opzoeken
ENRICH_SOCIALS=true            # 'false' zet het helemaal uit
ENRICH_LIMIT=12                # max. chains per run die verrijkt worden
ENRICH_BUDGET_SECONDS=150      # harde tijdslimiet voor alle verrijking samen

# Launch-detectie: RPC's van pre-launch chains pollen tot ze antwoorden
PROBE_ENABLED=true             # 'false' zet de wachtlijst en het pollen uit
PROBE_LIMIT=40                 # max. wachtlijst-items per run
PROBE_BUDGET_SECONDS=60        # harde tijdslimiet voor al het pollen samen
PROBE_TTL_DAYS=120             # daarna van de wachtlijst af, zonder bericht
INBOX_LIMIT=40                 # sequencer-inboxen per run
INBOX_BUDGET_SECONDS=45        # tijdslimiet voor het pollen van inboxen
INBOX_TTL_DAYS=180             # daarna stoppen met wachten op een eerste batch

# Stilstanddetectie
STALE_ALERT_HOURS=3            # waarschuw als de vorige run langer geleden was

# Stealth-detectie (alles optioneel, werkt zonder)
CT_PATTERNS=                   # komma-gescheiden crt.sh-patronen; leeg = standaardset
BLOB_MIN_TXS=3                 # drempel voor een naamloze blob-afzender
BLOB_PAGE_SIZE=100             # blob-transacties per run
EVM_RPC_ETHEREUM=              # eigen RPC's, komma-gescheiden; leeg = publieke endpoints
EVM_RPC_ARBITRUM=
EVM_RPC_BASE=

# Nieuwe pools op gekozen chains
DEX_POOL_CHAINS=               # leeg = robinhood,arc,elysium; giwa kan erbij
DEX_POOL_BUDGET_SECONDS=40
DEX_POOL_SYMBOL_SECONDS=20
EVM_RPC_ROBINHOOD=
EVM_RPC_ARC=
EVM_RPC_ELYSIUM=
